# Copie este archivo como .env (en la carpeta backend) y complete los valores.
# .env NUNCA se sube a Git (está en .gitignore). No comparta su contenido.

# --- Aplicación (solo localhost) ---
APP_HOST=127.0.0.1
# true = también la abren otras computadoras (Mac o Windows) de la MISMA red Wi-Fi en http://IP-de-este-equipo:8000
ACCESO_RED_LOCAL=false
APP_PORT=8000
ENTORNO=local
ZONA_HORARIA=America/Guatemala
NOMBRE_EMPRESA=Financiera Progreso

# --- MySQL local (usuario con privilegios mínimos, ver docs/MYSQL.md) ---
DATABASE_URL=mysql+pymysql://cobros_app:CAMBIE_ESTA_CLAVE_APP@127.0.0.1:3306/cobros_ia?charset=utf8mb4
# Usuario con permisos de DDL para migraciones y respaldos (scripts\mysql_crear_bd.sql)
DATABASE_URL_MIGRACIONES=mysql+pymysql://cobros_migra:CAMBIE_ESTA_CLAVE_MIGRA@127.0.0.1:3306/cobros_ia?charset=utf8mb4
# Carpeta de mysqldump.exe / mysql.exe si no están en el PATH
MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.4\bin
# Clave Fernet para cifrar respaldos (guárdela también fuera del equipo). Generar como GRABACIONES_CLAVE.
RESPALDO_CLAVE=

# --- Sesiones ---
COOKIE_SECURE=false
SESION_INACTIVIDAD_MIN=30
SESION_ABSOLUTA_HORAS=8

# --- Anthropic (agente y supervisores). Requiere Internet y saldo en la API (no incluido en Claude Pro) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5
ANTHROPIC_MODELO_SUPERVISOR=claude-sonnet-5-5
LLM_MAX_TOKENS_RESPUESTA=400
# Precios de referencia (USD por millón de tokens) para ESTIMAR costo. Verifique la tarifa vigente.
LLM_PRECIO_ENTRADA_MTOK=1.00
LLM_PRECIO_SALIDA_MTOK=5.00

# --- Deepgram (voz). Requiere Internet y créditos ---
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODELO=nova-3
DEEPGRAM_TTS_MODELO=aura-2-estrella-es
DEEPGRAM_IDIOMA=es

# --- Presupuesto estimado (USD) ---
PRESUPUESTO_DIARIO_USD=2.00
PRESUPUESTO_INTERACCION_USD=0.20

# --- Grabaciones cifradas (Fernet). Vacío = no se guarda audio. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GRABACIONES_CLAVE=
GRABACIONES_DIR=datos/grabaciones

# --- Telefonía FreeSWITCH (deshabilitada hasta contar con troncal SIP y número autorizado) ---
TELEFONIA_HABILITADA=false
FREESWITCH_ESL_PASSWORD=
FREESWITCH_DIR_AUDIO=
# Si FreeSWITCH corre en una VM Linux: ruta de la MISMA carpeta vista desde la VM (ver docs/ZOIPER_FREESWITCH.md)
FREESWITCH_DIR_AUDIO_REMOTO=
# Sin carpeta compartida: los audios se copian por scp a la VM (usuario@ip y llave privada autorizada en la VM)
FREESWITCH_SSH_DESTINO=
FREESWITCH_SSH_LLAVE=
TELEFONIA_SOLO_NUMEROS_AUTORIZADOS=true

# --- Llamada real de prueba con Twilio (ver docs/TWILIO.md). Solo llama a números autorizados. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=
TWILIO_VOZ=Polly.Mia-Neural
TWILIO_IDIOMA=es-MX
# Voz en la llamada: deepgram (voz Aura-2 del agente, más natural; usa créditos Deepgram) o twilio (TWILIO_VOZ)
TWILIO_MOTOR_VOZ=deepgram
# URL pública https del túnel. Vacía = se detecta sola si «ngrok http 8000» está abierto en este equipo.
# Por ella solo se aceptan los webhooks firmados de Twilio y los audios de un solo uso del agente.
URL_PUBLICA=
